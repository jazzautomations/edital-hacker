# Ver CREDENCIAIS.md — checklist passo a passo.
# Regra: chaves usadas por convex/*.ts (LLM_*, FIRECRAWL_*, RESEND_*,
# NVOIP_*, EVOLUTION_* se backend, ABACATEPAY_*, NOTIFY_SECRET, APP_URL)
# precisam TAMBÉM de `npx convex env set CHAVE valor`.

# Convex (rode `npx convex dev` — gera a URL)
NEXT_PUBLIC_CONVEX_URL=

# LLM
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Ingestão/enriquecimento de editais
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=

# Nvoip (SMS, torpedo de voz, WhatsApp oficial, OTP) — OAuth client do painel Desenvolvedor
NVOIP_OAUTH_CLIENT_ID=
NVOIP_OAUTH_CLIENT_SECRET=
NVOIP_SMS_TEMPLATE_ID=
NVOIP_WA_TEMPLATE_ID=
NVOIP_WA_INSTANCE=
NVOIP_CALLER=
NVOIP_WEBHOOK_SECRET=

# Evolution API (WhatsApp texto livre — canal de demo; produção = Nvoip WABA)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=jazz

# Segredo compartilhado Next <-> Convex p/ rota /api/notify + URL pública do app
NOTIFY_SECRET=
APP_URL=http://localhost:3000

# Alertas por email
RESEND_API_KEY=
RESEND_FROM="Manager <manager@seu-dominio.com>"
# Inbound (reply-detect sem Gmail): domínio de recebimento no painel Resend →
# webhook apontando p/ https://<deployment>.convex.site/webhooks/resend?webhookSecret=<RESEND_WEBHOOK_SECRET>
RESEND_WEBHOOK_SECRET=            # openssl rand -hex 32 🔁 Convex
RESEND_REPLY_TO=                  # ex: manager@<seu-inbox>.resend.app 🔁 Convex

# Auth (WorkOS AuthKit — sponsor). Redirect URI é var PÚBLICA (exigência da lib).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=          # >= 32 chars aleatórios (openssl rand -hex 32)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Composio — mãos do agente no mundo exterior (Gmail/Calendar/Drive +1000)
# auth_config_id criado no dashboard Composio (toolkit Gmail → create auth config)
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG=
COMPOSIO_CALENDAR_AUTH_CONFIG=
# secret retornado ao criar webhook_subscription (HMAC do webhook de triggers)
COMPOSIO_WEBHOOK_SECRET=

# Pagamentos (AbacatePay — sandbox no hackathon)
ABACATEPAY_API_KEY=
ABACATEPAY_SANDBOX=true
ABACATEPAY_WEBHOOK_SECRET=        # secret do webhook no painel 🔁 Convex
ABACATE_UNLOCK_PRICE_CENTS=990    # preço do "destrava edital" p/ QR Pix inline 🔁 Convex
ABACATE_PRODUCT_UNLOCK=
ABACATE_PRODUCT_MANAGER_MONTHLY=
ABACATE_PRODUCT_MANAGER_ANNUAL=
ABACATE_PRODUCT_PRO_MONTHLY=
ABACATE_PRODUCT_PRO_ANNUAL=

# Agora Conversational AI (sabatina por voz — ASR/TTS managed)
AGORA_APP_ID=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_APP_CERTIFICATE=
VOICE_LLM_API_KEY=
